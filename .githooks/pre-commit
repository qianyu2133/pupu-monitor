#!/bin/sh
# 提交前拦截用户数据与密钥。
# 安装在 .githooks/，通过 `git config core.hooksPath .githooks` 生效。
# 这是最后一道防线：即便 .gitignore 被误改，也不会把 token 推上去。

blocked=$(git diff --cached --name-only --diff-filter=ACMR | \
  grep -E '(^|/)(data|dist|build)/|\.(db|key|pem|cer|p12|sqlite|sqlite3)$|^config\.json$' || true)

if [ -n "$blocked" ]; then
  echo ""
  echo "  拒绝提交：以下文件属于用户数据或密钥"
  echo "$blocked" | sed 's/^/    /'
  echo ""
  echo "  如果你确实需要提交它们，先确认里面没有 token / 地址 / 订单号。"
  echo ""
  exit 1
fi

tmp=$(mktemp 2>/dev/null || echo "/tmp/_precommit_$$")
git diff --cached -U0 --diff-filter=ACMR | grep -E '^\+' | grep -vE '^\+\+\+' > "$tmp" 2>/dev/null || true

fail=0

count=$(grep -cE '1[3-9][0-9]{9}' "$tmp" 2>/dev/null || true)
if [ "${count:-0}" -gt 0 ]; then
  echo ""
  echo "  拒绝提交：暂存内容里有 $count 处疑似手机号（不显示具体内容）"
  fail=1
fi

count=$(grep -cE 'eyJ[A-Za-z0-9_-]{20,}' "$tmp" 2>/dev/null || true)
if [ "${count:-0}" -gt 0 ]; then
  echo "  拒绝提交：暂存内容里有 $count 处疑似 JWT / Token"
  fail=1
fi

count=$(grep -cE 'qyapi\.weixin\.qq\.com[^ "]*key=' "$tmp" 2>/dev/null || true)
if [ "${count:-0}" -gt 0 ]; then
  echo "  拒绝提交：暂存内容里有企业微信 webhook 密钥"
  fail=1
fi

rm -f "$tmp"

if [ "$fail" -ne 0 ]; then
  echo ""
  echo "  这些内容一旦推到 GitHub 就再也删不干净（会被 fork、被缓存）。"
  echo "  请先脱敏，或用 git commit --no-verify 确认风险后强制提交。"
  echo ""
  exit 1
fi

exit 0
